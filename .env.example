# herald-smtp - SMTP email adapter for Herald
# Herald calls this service via HTTP; all SMTP credentials live here only.

# Listen port. Can be with or without leading colon (e.g. 8084 or :8084).
PORT=:8084
LOG_LEVEL=info

# Optional: API key for callers. If set, Herald must send X-API-Key with this value;
# configure Herald with HERALD_SMTP_API_KEY set to the same value.
# API_KEY=

# SMTP server (required for send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Transport security. TLS and STARTTLS cannot both be enabled.
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
# Development only; keep false in production.
SMTP_SKIP_TLS_VERIFY=false
SMTP_TIMEOUT_SECONDS=30

# Idempotency cache TTL in seconds. Same idempotency_key (header or body) within
# this window returns cached response without sending again.
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_MAX_ENTRIES=10000

# HTTP resource bounds.
HTTP_BODY_LIMIT_BYTES=65536
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=40
HTTP_IDLE_TIMEOUT_SECONDS=60
